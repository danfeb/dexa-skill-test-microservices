  "type": "module",
  "scripts": {
    "build": "nest build api-gateway && nest build auth-services && nest build master-services && nest build attendance-services && nest build upload-services",
    "build:gateway": "nest build api-gateway",
    "build:auth": "nest build auth-services",
    "build:master": "nest build master-services",
    "build:attendance": "nest build attendance-services",
    "build:upload": "nest build upload-services",
    "deploy": "nest deploy",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start api-gateway",
    "start:dev": "nest start api-gateway --watch",
    "start:debug": "nest start api-gateway --debug --watch",
    "start:auth": "nest start auth-services",
    "start:auth:dev": "nest start auth-services --watch",
    "start:master": "nest start master-services",
    "start:master:dev": "nest start master-services --watch",
    "start:attendance": "nest start attendance-services",
    "start:attendance:dev": "nest start attendance-services --watch",
    "start:upload": "nest start upload-services",
    "start:upload:dev": "nest start upload-services --watch",
    "start:prod": "node dist/apps/api-gateway/main.js",
    "start:prod:auth": "node dist/apps/auth-services/main.js",
    "start:prod:master": "node dist/apps/master-services/main.js",
    "start:prod:attendance": "node dist/apps/attendance-services/main.js",
    "start:prod:upload": "node dist/apps/upload-services/main.js",
    "lint": "oxlint --type-aware apps/ libs/",
    "db:init": "bash scripts/oracle/init.sh",
    "sign": "node --env-file=.env scripts/generate-signature.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
