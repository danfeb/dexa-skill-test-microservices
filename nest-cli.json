{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack"
  },
  "monorepo": true,
  "root": "apps/api-gateway",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "attendance-services": {
      "type": "application",
      "root": "apps/attendance-services",
      "entryFile": "main",
      "sourceRoot": "apps/attendance-services/src",
      "compilerOptions": {
        "tsConfigPath": "apps/attendance-services/tsconfig.app.json"
      }
    },
    "auth-services": {
      "type": "application",
      "root": "apps/auth-services",
      "entryFile": "main",
      "sourceRoot": "apps/auth-services/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-services/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "master-services": {
      "type": "application",
      "root": "apps/master-services",
      "entryFile": "main",
      "sourceRoot": "apps/master-services/src",
      "compilerOptions": {
        "tsConfigPath": "apps/master-services/tsconfig.app.json"
      }
    },
    "upload-services": {
      "type": "application",
      "root": "apps/upload-services",
      "entryFile": "main",
      "sourceRoot": "apps/upload-services/src",
      "compilerOptions": {
        "tsConfigPath": "apps/upload-services/tsconfig.app.json"
      }
    }
  }
}